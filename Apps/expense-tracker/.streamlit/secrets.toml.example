# Copy to .streamlit/secrets.toml (local) or paste into Streamlit Cloud -> Settings -> Secrets.

# Leave out locally to use SQLite (expenses.db). For Supabase use the *Session pooler* string:
# DATABASE_URL = "postgresql://postgres.xxxxx:YOUR_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres"

INVITE_CODE = "change-me"   # people need this to sign up
MAX_USERS = 10
